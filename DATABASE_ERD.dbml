// Serena / Floréa – DBML untuk dbdiagram.io
// Tempel isi file ini di https://dbdiagram.io/d → Export PNG/PDF.
// Wellness/Kesehatan dihapus (mood_logs, sleep_logs, habits, habit_logs).

Enum task_priority {
  low
  medium
  high
  urgent
}

Enum task_status {
  pending
  in_progress
  completed
  cancelled
}

Enum focus_mode {
  pomodoro
  deep_focus
  exam_mode
}

Enum focus_status {
  active
  paused
  completed
  cancelled
}

Enum notification_type {
  task
  deadline
  focus_break
}

Table auth.users {
  id uuid [pk]
}

Table profiles {
  id uuid [pk, ref: - auth.users.id]
  email text
  full_name text
  avatar_url text
  onboarding_completed boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table user_goals {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth.users.id]
  title text [not null]
  description text
  target_date date
  is_completed boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table task_categories {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth.users.id]
  name text [not null]
  color text
  icon text
  created_at timestamptz [not null, default: `now()`]
}

Table tasks {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth.users.id]
  category_id uuid [ref: > task_categories.id]
  title text [not null]
  description text
  deadline timestamptz
  priority task_priority [not null, default: 'medium']
  status task_status [not null, default: 'pending']
  progress int [not null, default: 0]
  reminder_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table focus_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth.users.id]
  mode focus_mode [not null, default: 'pomodoro']
  planned_minutes int [not null]
  actual_minutes int
  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz
  status focus_status [not null, default: 'active']
  note text
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth.users.id]
  type notification_type [not null]
  title text [not null]
  body text
  scheduled_for timestamptz
  is_read boolean [not null, default: false]
  related_id uuid
  created_at timestamptz [not null, default: `now()`]
}

Table achievements {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  title text [not null]
  description text
  icon text
  criteria jsonb [not null, default: '{}']
}

Table user_achievements {
  user_id uuid [not null, ref: > auth.users.id]
  achievement_id uuid [not null, ref: > achievements.id]
  progress int [not null, default: 0]
  unlocked_at timestamptz

  indexes {
    (user_id, achievement_id) [pk]
  }
}
